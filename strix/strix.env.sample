# strix.env.sample — Strix (usestrix/strix 1.7.x) client settings for this server.
# Copy to strix/strix.env on the machine that runs Strix, set LLM_API_BASE and
# LLM_API_KEY, then run scans through strix/run-strix.sh (it loads this file).
# Every value below was chosen against a measured failure; docs/STRIX.md has
# the numbers. Strix reads these from the environment, so `set -a; source
# strix/strix.env; set +a` works too if you call strix yourself.

# --- endpoint ---------------------------------------------------------------
# The openai/ prefix routes through Strix's native OpenAI client (streaming,
# native tool calls). The part after it must equal SERVED_MODEL_NAME.
STRIX_LLM="openai/qwen3.8-flash-next"
LLM_API_BASE="http://SPARK_HOST:8888/v1"
# The server's API_KEY (.env on the Spark: grep '^API_KEY=' .env). Without it
# every request is a 401.
LLM_API_KEY=""

# --- timeouts (seconds) -----------------------------------------------------
# Strix's defaults are cloud numbers: 120 s to the first streamed event and
# 600 s per response. Here a cold 150k-token prefill plus queueing behind three
# other agents takes longer than that, Strix abandons the request, retries it
# from scratch and the server prefills it again (84 abandoned requests in the
# 7.6 h run of 2026-11-20). 0 = no total cap; the idle cap still catches a
# stalled stream.
LLM_TIMEOUT=1800
LLM_STREAM_FIRST_EVENT_TIMEOUT=1200
LLM_STREAM_IDLE_TIMEOUT=600
LLM_STREAM_TOTAL_TIMEOUT=0

# --- output and reasoning caps (merged into EVERY request) --------------------
# Strix never sends max_tokens to an unmapped model, and its context-compaction
# summary asks for 4,096 tokens, which the model's own reasoning used up: the
# summary came back empty, compaction silently did nothing and agent contexts
# grew to 200-500k tokens. Values here override the per-call ones (extra_body
# is merged last), so the summary call also gets 16,384.
# thinking_token_budget (vLLM): reasoning is cut at this many tokens and the
# model is made to answer, so a runaway think cannot eat max_tokens. Raise or
# drop it if your scans need deeper reasoning per step.
LLM_EXTRA_BODY='{"max_tokens":16384,"thinking_token_budget":8192}'
# Per-scan reasoning depth instead of the server default (medium). The stock
# template accepts low, medium and xhigh only ("high" is an error). For an A/B
# with deeper reasoning keep the budget generous and the cap well above it: a
# tight budget cuts the model off mid-thought (docs/STRIX.md, reasoning effort).
# LLM_EXTRA_BODY='{"max_tokens":24576,"thinking_token_budget":12288,"chat_template_kwargs":{"reasoning_effort":"xhigh"}}'
# LLM_EXTRA_BODY='{"max_tokens":16384,"thinking_token_budget":8192,"chat_template_kwargs":{"reasoning_effort":"low"}}'

# --- context management -----------------------------------------------------
# Window Strix assumes for a model LiteLLM does not know; compaction starts at
# this minus STRIX_CONTEXT_BUFFER_TOKENS (20k), counting Strix's own system
# prompt and tool schemas, which are already ~64k tokens per agent. 200k leaves
# ~116k of history per agent, stays under the server's 262k/512k, and lets
# several agents share the KV cache. Do not go below ~110k.
STRIX_CONTEXT_FALLBACK_TOKENS=200000
# Summary allowance (Strix caps it at 8,192 for unmapped models; LLM_EXTRA_BODY
# above already lifts the real request to 16,384).
STRIX_CONTEXT_SUMMARY_TOKENS=8192
# Tool output kept per call. Every token stays in the agent's context until the
# next compaction, so trimming here slows context growth. Default 8000.
# STRIX_TOOL_OUTPUT_MAX_TOKENS=6000

# --- reporting --------------------------------------------------------------
# Only changes Strix's cache-miss accounting: the server caches prompts in
# 1,680-token blocks (hybrid model), not OpenAI's 128.
STRIX_CACHE_BLOCK_TOKENS=1680
# Strix sends anonymous usage telemetry by default. Off for private targets.
STRIX_TELEMETRY=false

# --- run-strix.sh only ------------------------------------------------------
# STRIX_BIN=strix                       # path to the strix binary
# STRIX_METRICS_URL=http://SPARK_HOST:8888/metrics   # default: derived from LLM_API_BASE
# STRIX_REPORT_DIR=./strix-server-reports            # where the per-run server report goes
